# ─── Auth Provider ────────────────────────────────────────────────────────────
# "supabase" → uses Supabase Auth (local Docker or cloud, same code)
# "local"    → uses plain Postgres sessions (no Supabase required)
AUTH_PROVIDER=supabase

# ─── Database ─────────────────────────────────────────────────────────────────
# Works with ANY Postgres — local, Supabase local, or cloud Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsa_planner

# ─── Supabase (only needed when AUTH_PROVIDER=supabase) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── AI provider ──────────────────────────────────────────────────────────────
# "claude" → Claude Code CLI + Anthropic SDK (needs ANTHROPIC_API_KEY below)
# "pi"     → pi CLI (`pi --mode json`); uses pi's own login/provider auth
AI_PROVIDER=claude

# ─── Pi (only needed when AI_PROVIDER=pi) ─────────────────────────────────────
# PI_MODEL is the default model as provider/id (see `pi --list-models`).
# PI_PROVIDER is prepended to bare ids the agents request (claude-haiku-4-5 → kiro/claude-haiku-4-5).
PI_PATH=pi
PI_MODEL=kiro/claude-sonnet-5-5
PI_PROVIDER=kiro
# off | minimal | low | medium | high | xhigh | max (empty = model default)
PI_THINKING=
PI_TIMEOUT_MS=120000

# ─── Agent (Pi SDK, in-process) ───────────────────────────────────────────────
# Absolute paths of Pi extensions to load. Only model-provider extensions belong here.
# Find kiro with: ls ~/.pi/agent/npm/node_modules/pi-provider-kiro/dist/index.js
PI_EXTENSION_PATHS=/Users/you/.pi/agent/npm/node_modules/pi-provider-kiro/dist/index.js
# Empty directory the agent session uses as cwd (created if missing).
AGENT_WORK_DIR=/tmp/dsa-planner-agent

# ─── Obsidian vault (optional) ───────────────────────────────────────────────
# Absolute path of the vault folder (Google Drive for Desktop keeps it in sync).
VAULT_PATH=
# The user whose memory the vault feeds (one main user on this machine).
VAULT_USER_ID=

# ─── Tests ────────────────────────────────────────────────────────────────────
# Separate database for integration tests. The pgvector extension must be available.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsa_planner_test

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Practice reminders (email) ───────────────────────────────────────────────
# Every 2 hours from 10 AM to 11:59 PM until today's plan day is marked done.
# Off when SMTP_HOST/SMTP_USER/SMTP_PASS are empty. Gmail: use an App Password
# (Google Account → Security → 2-Step Verification → App passwords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional; defaults to "DSA Planner <SMTP_USER>"
MAIL_FROM=
REMINDER_TIMEZONE=Asia/Kolkata
# Set to false to switch reminders off without removing the SMTP settings
REMINDERS_ENABLED=true

# ─── LeetCode (optional — raises rate limit) ──────────────────────────────────
LEETCODE_SESSION_COOKIE=
LEETCODE_RATE_LIMIT_PER_MINUTE=10
LEETCODE_SYNC_COOLDOWN_SECONDS=300

# ─── Feature flags ────────────────────────────────────────────────────────────
FEATURE_MOCK_INTERVIEW=false
USE_MOCK_AI=false
